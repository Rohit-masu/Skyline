DATABASE_URL=            # Neon Postgres connection string. Unset = enquiries kept in memory (local dev only)
IP_HASH_SALT=            # required: random string; IPs are stored only as salted SHA-256
ADMIN_PASSWORD=          # optional: turns on /admin (enquiry list)
NEXT_PUBLIC_SITE_URL=    # e.g. https://skyline-xyz.vercel.app (canonical and OG URLs)
